# ─── Sanchay — Environment Variables Template ────────────────────────────────
# Copy this file to server-node-sdk/.env and fill in your values.
# DO NOT commit the actual .env file to git.
# ──────────────────────────────────────────────────────────────────────────────

# ─── JWT Configuration ───────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=24h

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000

# ─── Email (Gmail SMTP) ──────────────────────────────────────────────────────
# Generate App Password: Google Account → Security → 2-Step Verification → App passwords
EMAIL_USER=your-email@gmail.com
EMAIL_APP_PASSWORD=your-gmail-app-password

# ─── AES-256-GCM Encryption ─────────────────────────────────────────────────
# 64-char hex string (32 bytes). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AES_ENCRYPTION_KEY=your-64-char-hex-key-here

# ─── Pinata IPFS ─────────────────────────────────────────────────────────────
# Get keys from: https://app.pinata.cloud/developers/api-keys
PINATA_API_KEY=your-pinata-api-key
PINATA_SECRET_API_KEY=your-pinata-secret-api-key

# ─── Frontend (Vite) ─────────────────────────────────────────────────────────
# Used by the frontend to know where the API lives
VITE_API_URL=http://localhost:5000
